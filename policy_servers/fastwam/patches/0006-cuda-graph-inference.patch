+import random
+
+import pytest
+import torch
+
+from fastwam.models.wan22.graphed_infer import GraphedActionInfer, device_resident_constants
+from test_history_conditioning import ACTION_HORIZON, PROPRIO_DIM, TEXT_DIM, FakeVAE, build_model
+
+HEIGHT, WIDTH = 64, 128
+CONTEXT_LEN = 5
+NUM_STEPS = 3
+
+needs_cuda = pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA graphs need a GPU")
+
+
+class _TypedFakeVAE(FakeVAE):
+    def __init__(self, dtype: torch.dtype):
+        super().__init__()
+        self.dtype = dtype
+
+    def encode(self, videos, device, tiled=False, tile_size=(30, 52), tile_stride=(15, 26)):
+        return super().encode(videos, device, tiled, tile_size, tile_stride).to(self.dtype)
+
+
+def _cuda_model(dtype: torch.dtype):
+    model = build_model().to(device="cuda", dtype=dtype)
+    model.vae = _TypedFakeVAE(dtype)
+    model.device = torch.device("cuda")
+    model.torch_dtype = dtype
+    return model.eval()
+
+
+def _request(seed: int, num_history: int, history_width: int, is_pad: tuple[bool, ...], dtype: torch.dtype):
+    gen = torch.Generator().manual_seed(seed)
+    request = {
+        "prompt": None,
+        "input_image": (torch.rand(1, 3, HEIGHT, WIDTH, generator=gen) * 2 - 1).to("cuda", dtype),
+        "action_horizon": ACTION_HORIZON,
+        "proprio": torch.randn(1, PROPRIO_DIM, generator=gen),
+        "context": torch.randn(CONTEXT_LEN, TEXT_DIM, generator=gen).to(dtype),
+        "context_mask": torch.ones(CONTEXT_LEN, dtype=torch.bool),
+        "num_inference_steps": NUM_STEPS,
+        "seed": 42 + seed,
+    }
+    if num_history:
+        request["history_images"] = (
+            torch.rand(num_history, 3, HEIGHT, history_width, generator=gen) * 2 - 1
+        ).to("cuda", dtype)
+        request["history_is_pad"] = torch.tensor(is_pad, dtype=torch.bool)
+    return request
+
+
+@needs_cuda
+@pytest.mark.parametrize("reuse", [False, True], ids=["per_step", "reuse_invariants"])
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
+@pytest.mark.parametrize(
+    ("num_history", "history_width"), [(0, WIDTH), (2, WIDTH), (2, WIDTH // 2)], ids=["none", "full", "narrow"]
+)
+def test_graph_equals_eager_bitwise(dtype, num_history, history_width, reuse):
+    model = _cuda_model(dtype)
+    graphed = GraphedActionInfer(
+        model,
+        height=HEIGHT,
+        width=WIDTH,
+        num_history=num_history,
+        history_width=history_width,
+        context_len=CONTEXT_LEN,
+        action_horizon=ACTION_HORIZON,
+        num_inference_steps=NUM_STEPS,
+        reuse_step_invariants=reuse,
+    )
+    pads = [(False, False), (True, False), (True, True)] if num_history else [()]
+    requests = [_request(i, num_history, history_width, pads[i % len(pads)], dtype) for i in range(6)]
+    order = list(range(len(requests))) * 2
+    random.Random(0).shuffle(order)
+    for i in order:
+        expected = model.infer_action(**requests[i])["action"]
+        got = graphed.infer_action(**requests[i])["action"]
+        assert torch.equal(got, expected), f"request {i} differs: max |diff| {(got - expected).abs().max()}"
+
+
+@needs_cuda
+def test_graph_leaves_the_eager_model_unchanged():
+    model = _cuda_model(torch.float32)
+    request = _request(0, 2, WIDTH // 2, (True, False), torch.float32)
+    before = model.infer_action(**request)["action"]
+    freqs = (model.video_expert.freqs, model.action_expert.freqs)
+    GraphedActionInfer(
+        model,
+        height=HEIGHT,
+        width=WIDTH,
+        num_history=2,
+        history_width=WIDTH // 2,
+        context_len=CONTEXT_LEN,
+        action_horizon=ACTION_HORIZON,
+        num_inference_steps=NUM_STEPS,
+    )
+    assert model.video_expert.freqs is freqs[0] and model.action_expert.freqs is freqs[1]
+    assert torch.equal(model.infer_action(**request)["action"], before)
+
+
+@needs_cuda
+def test_capture_under_grad_mode_keeps_no_autograd_graph():
+    model = _cuda_model(torch.float32)
+    assert torch.is_grad_enabled() and any(p.requires_grad for p in model.parameters())
+    graphed = GraphedActionInfer(
+        model,
+        height=HEIGHT,
+        width=WIDTH,
+        num_history=2,
+        history_width=WIDTH // 2,
+        context_len=CONTEXT_LEN,
+        action_horizon=ACTION_HORIZON,
+        num_inference_steps=NUM_STEPS,
+    )
+    assert graphed.action.grad_fn is None and not graphed.action.requires_grad
+
+
+@pytest.mark.skipif(torch.cuda.device_count() < 2, reason="needs a second GPU")
+def test_graph_on_a_device_other_than_the_current_one():
+    model = build_model().to("cuda:1")
+    model.device = torch.device("cuda:1")
+    model.eval()
+    request = _request(0, 2, WIDTH // 2, (True, False), torch.float32)
+    request["input_image"] = request["input_image"].to("cuda:1")
+    request["history_images"] = request["history_images"].to("cuda:1")
+    with torch.cuda.device(0):
+        graphed = GraphedActionInfer(
+            model,
+            height=HEIGHT,
+            width=WIDTH,
+            num_history=2,
+            history_width=WIDTH // 2,
+            context_len=CONTEXT_LEN,
+            action_horizon=ACTION_HORIZON,
+            num_inference_steps=NUM_STEPS,
+        )
+        for seed in (0, 1):
+            other = _request(seed + 1, 2, WIDTH // 2, (False, False), torch.float32)
+            other["input_image"] = other["input_image"].to("cuda:1")
+            other["history_images"] = other["history_images"].to("cuda:1")
+            for req in (request, other):
+                assert torch.equal(graphed.infer_action(**req)["action"], model.infer_action(**req)["action"])
+
+
+@needs_cuda
+def test_graph_refuses_other_shapes():
+    model = _cuda_model(torch.float32)
+    graphed = GraphedActionInfer(
+        model,
+        height=HEIGHT,
+        width=WIDTH,
+        num_history=0,
+        history_width=WIDTH,
+        context_len=CONTEXT_LEN,
+        action_horizon=ACTION_HORIZON,
+        num_inference_steps=NUM_STEPS,
+    )
+    request = _request(0, 0, WIDTH, (), torch.float32)
+    with pytest.raises(ValueError, match="num_inference_steps"):
+        graphed.infer_action(**{**request, "num_inference_steps": NUM_STEPS + 1})
+    with pytest.raises(ValueError, match="history_images"):
+        graphed.infer_action(**_request(0, 2, WIDTH, (False, False), torch.float32))
+    with pytest.raises(ValueError, match="precomputed"):
+        graphed.infer_action(**{**request, "prompt": "pick", "context": None, "context_mask": None})
+
+
+def test_refuses_a_cpu_model():
+    with pytest.raises(ValueError, match="CUDA device"):
+        GraphedActionInfer(
+            build_model(),
+            height=HEIGHT,
+            width=WIDTH,
+            num_history=0,
+            history_width=WIDTH,
+            context_len=CONTEXT_LEN,
