+import pytest
+import torch
+from omegaconf import OmegaConf
+
+from fastwam.datasets.lerobot import robot_video_dataset
+from fastwam.models.wan22.fastwam_idm import FastWAMIDM
+
+from test_history_conditioning import ACTION_DIM, ACTION_HORIZON, BATCH, PROPRIO_DIM, TEXT_DIM, Z_DIM, build_model
+
+HEIGHT, WIDTH = 64, 128
+NARROW_WIDTH = WIDTH // 2
+NUM_FRAMES = 9
+NUM_HISTORY = 2
+
+
+def _sample(history_width=NARROW_WIDTH):
+    torch.manual_seed(1)
+    return {
+        "video": torch.rand(BATCH, 3, NUM_FRAMES, HEIGHT, WIDTH) * 2 - 1,
+        "action": torch.randn(BATCH, ACTION_HORIZON, ACTION_DIM),
+        "proprio": torch.randn(BATCH, ACTION_HORIZON, PROPRIO_DIM),
+        "context": torch.randn(BATCH, 5, TEXT_DIM),
+        "context_mask": torch.ones(BATCH, 5, dtype=torch.bool),
+        "action_is_pad": torch.zeros(BATCH, ACTION_HORIZON, dtype=torch.bool),
+        "image_is_pad": torch.zeros(BATCH, NUM_FRAMES, dtype=torch.bool),
+        "history_video": torch.rand(BATCH, 3, NUM_HISTORY, HEIGHT, history_width) * 2 - 1,
+        "history_is_pad": torch.tensor([[True, False], [False, False]]),
+    }
+
+
+def _infer(model, history_width=NARROW_WIDTH, history_is_pad=None):
+    torch.manual_seed(4)
+    return model.infer_action(
+        prompt=None,
+        input_image=torch.rand(1, 3, HEIGHT, WIDTH) * 2 - 1,
+        action_horizon=ACTION_HORIZON,
+        history_images=torch.rand(NUM_HISTORY, 3, HEIGHT, history_width) * 2 - 1,
+        history_is_pad=history_is_pad,
+        context=torch.randn(1, 5, TEXT_DIM),
+        context_mask=torch.ones(1, 5, dtype=torch.bool),
+        proprio=torch.randn(1, PROPRIO_DIM),
+        num_inference_steps=2,
+        seed=0,
+    )["action"]
+
+
+def _loss(model, sample):
+    torch.manual_seed(5)
+    loss, _ = model.training_loss(sample)
+    return loss.detach()
+
+
+def _fill_padding(model, value_seed):
+    original = model._pad_narrow_history_latents
+
+    def pad(history_latents, latent_width):
+        padded, hidden = original(history_latents, latent_width)
+        generator = torch.Generator().manual_seed(value_seed)
+        width = history_latents.shape[-1]
+        padded = padded.clone()
+        padded[..., width:] = 100 * torch.randn(padded[..., width:].shape, generator=generator)
+        return padded, hidden
+
+    model._pad_narrow_history_latents = pad
+
+
+def test_hidden_tokens_are_the_padding_columns_of_the_history_slots():
+    model = build_model()
+    history = torch.randn(1, Z_DIM, NUM_HISTORY, 4, 4)
+    padded, hidden = model._pad_narrow_history_latents(history, latent_width=8)
+    assert tuple(padded.shape) == (1, Z_DIM, NUM_HISTORY, 4, 8)
+    assert torch.equal(padded[..., :4], history)
+    expected = torch.zeros(NUM_HISTORY + 1, 2, 4, dtype=torch.bool)
+    for slot in range(NUM_HISTORY):
+        for col in (2, 3):
+            expected[slot, :, col] = True
+    assert torch.equal(hidden, expected.reshape(1, -1))
+
+
+def test_full_width_history_hides_nothing():
+    model = build_model()
+    history = torch.randn(1, Z_DIM, NUM_HISTORY, 4, 8)
+    padded, hidden = model._pad_narrow_history_latents(history, latent_width=8)
+    assert padded is history and hidden is None
+
+
+def test_padding_values_never_reach_the_loss_or_the_actions():
+    model = build_model()
+    sample = _sample()
+    loss_zero = _loss(model, sample)
+    action_zero = _infer(model)
+    _fill_padding(model, value_seed=11)
+    assert torch.equal(_loss(model, sample), loss_zero)
+    assert torch.equal(_infer(model), action_zero)
+
+
+def test_the_padding_would_leak_without_hiding_it():
+    model = build_model()
+    sample = _sample()
+    loss_zero = _loss(model, sample)
+    _fill_padding(model, value_seed=11)
+    hide = model._hide_cond_tokens
+    model._hide_cond_tokens = lambda mask, cond_is_pad, video_tokens_per_frame, cond_token_is_hidden: hide(
+        mask, cond_is_pad, video_tokens_per_frame, None
+    )
+    assert not torch.equal(_loss(model, sample), loss_zero)
+
+
+def test_equals_a_sequence_without_the_padding_tokens():
+    model = build_model()
+    sample = _sample()
+    loss_masked = _loss(model, sample)
+
+    tokens_per_frame = 2 * 4
+    num_video_tokens = (NUM_HISTORY + 3) * tokens_per_frame
+    keep = torch.ones(NUM_HISTORY + 3, 2, 4, dtype=torch.bool)
+    keep[:NUM_HISTORY, :, 2:] = False
+    keep = keep.reshape(-1)
+    assert keep.numel() == num_video_tokens
+
+    forward = model.mot.forward
+
+    def forward_without_padding(embeds_all, attention_mask, freqs_all, context_all, t_mod_all):
+        num_action = embeds_all["action"].shape[1]
+        keep_all = torch.cat([keep, torch.ones(num_action, dtype=torch.bool)])
+        video_context = dict(context_all["video"], mask=context_all["video"]["mask"][:, keep])
+        out = forward(
+            embeds_all={"video": embeds_all["video"][:, keep], "action": embeds_all["action"]},
+            attention_mask=attention_mask[..., keep_all, :][..., keep_all],
+            freqs_all={"video": freqs_all["video"][keep], "action": freqs_all["action"]},
+            context_all={"video": video_context, "action": context_all["action"]},
+            t_mod_all={"video": t_mod_all["video"][:, keep], "action": t_mod_all["action"]},
+        )
+        video = torch.zeros_like(embeds_all["video"])
+        video[:, keep] = out["video"]
+        return {"video": video, "action": out["action"]}
+
+    model.mot.forward = forward_without_padding
+    loss_dropped = _loss(model, sample)
+    assert torch.allclose(loss_dropped, loss_masked, rtol=1e-5, atol=1e-7)
+
+
+def test_padded_history_slots_stay_hidden_with_narrow_history():
+    model = build_model()
+    is_pad = torch.tensor([True, False])
+    action_a = _infer(model, history_is_pad=is_pad)
+    original = model._encode_history_image_latents
+
+    def encode(history_video, **kwargs):
+        latents = original(history_video, **kwargs).clone()
+        latents[:, :, 0] = torch.randn(latents[:, :, 0].shape, generator=torch.Generator().manual_seed(3))
+        return latents
+
+    model._encode_history_image_latents = encode
+    assert torch.equal(_infer(model, history_is_pad=is_pad), action_a)
+
+
