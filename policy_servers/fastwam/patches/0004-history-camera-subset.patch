+            history_images=torch.rand(NUM_HISTORY, 3, HEIGHT, NARROW_WIDTH) * 2 - 1,
+            context=torch.randn(1, 5, TEXT_DIM),
+            context_mask=torch.ones(1, 5, dtype=torch.bool),
+            num_inference_steps=2,
+            seed=0,
+            test_action_with_infer_action=False,
+        )
+
+
+class _StubLerobotDataset:
+    def __init__(self, **kwargs):
+        pass
+
+    def _set_return_images(self, flag):
