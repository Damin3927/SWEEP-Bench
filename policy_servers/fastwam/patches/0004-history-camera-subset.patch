+    return robot_video_dataset.RobotVideoDataset(
+        dataset_dirs=[],
+        shape_meta=SHAPE_META,
+        video_size=[224, 448],
+        history_camera_keys=history_camera_keys,
+    )
+
+
+def test_exterior_history_is_the_exterior_camera_of_the_two_camera_history(monkeypatch):
+    dataset = _dataset(monkeypatch, ["opst_cam"])
+    torch.manual_seed(9)
+    exterior = torch.rand(NUM_HISTORY, 3, 224, 224)
+    wrist = torch.rand(NUM_HISTORY, 3, 224, 224)
+    history = torch.stack([exterior, wrist])
+
+    full = dataset._process_multicam_video(history)
+    narrow = dataset._select_history_cameras(full, num_cameras=2)
+    assert tuple(narrow.shape) == (3, NUM_HISTORY, 224, 224)
+    assert torch.equal(narrow, full[..., :224])
+    assert torch.equal(narrow, dataset.normalize_transform(exterior).permute(1, 0, 2, 3))
+
+
+def test_history_camera_keys_default_keeps_every_camera(monkeypatch):
+    assert _dataset(monkeypatch, None).history_camera_indices is None
+    assert _dataset(monkeypatch, ["wrist_cam"]).history_camera_indices == [1]
+    with pytest.raises(ValueError, match="must name cameras"):
+        _dataset(monkeypatch, ["side_cam"])
