+def mask_hidden_cond_tokens(mask: torch.Tensor, cond_token_is_hidden: torch.Tensor) -> torch.Tensor:
+    batch_size, cond_token_len = cond_token_is_hidden.shape
+    total_seq_len = int(mask.shape[0])
+    col_hidden = torch.zeros((batch_size, total_seq_len), dtype=torch.bool, device=mask.device)
+    col_hidden[:, :cond_token_len] = cond_token_is_hidden.to(mask.device)
+    return mask.view(1, 1, total_seq_len, total_seq_len) & ~col_hidden.view(batch_size, 1, 1, total_seq_len)
+
