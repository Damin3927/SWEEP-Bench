+MAX_8BIT_GROUP_NUMEL = 2**30
+
+
+def chunk_params(params: list[torch.nn.Parameter], max_numel: int) -> list[list[torch.nn.Parameter]]:
+    groups: list[list[torch.nn.Parameter]] = [[]]
+    size = 0
+    for param in params:
+        if param.numel() > max_numel:
+            raise ValueError(f"a single parameter has {param.numel()} elements, above {max_numel}")
+        if groups[-1] and size + param.numel() > max_numel:
+            groups.append([])
+            size = 0
+        groups[-1].append(param)
+        size += param.numel()
+    return groups
+
+
+def build_optimizer(
+    name: str,
+    params: list[torch.nn.Parameter],
+    *,
+    lr: float,
+    weight_decay: float,
+    betas: tuple[float, float],
+) -> torch.optim.Optimizer:
+    if name == "adamw":
+        return torch.optim.AdamW(params, lr=lr, weight_decay=weight_decay, betas=betas)
+    if name == "adamw8bit":
+        import bitsandbytes as bnb
+
+        return bnb.optim.AdamW8bit(
+            [{"params": group} for group in chunk_params(params, MAX_8BIT_GROUP_NUMEL)],
+            lr=lr,
+            weight_decay=weight_decay,
+            betas=betas,
+        )
+    raise ValueError(f"Unknown optimizer: {name!r}. Expected one of: ['adamw', 'adamw8bit'].")
+
