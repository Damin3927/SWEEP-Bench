+import json
+
+
+def task_instruction(task: str) -> str:
+    try:
+        record = json.loads(task)
+    except ValueError:
+        return task
+    if not isinstance(record, dict) or record.get("task") != "raw":
+        return task
+    instructions = record.get("instructions")
+    if not isinstance(instructions, list) or len(instructions) != 1 or not isinstance(instructions[0], str):
+        raise ValueError(f"raw task must carry exactly one instruction string, got {task!r}")
+    return instructions[0]
