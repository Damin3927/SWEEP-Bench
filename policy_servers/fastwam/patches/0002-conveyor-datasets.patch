+++ b/tests/test_sweep_bench_config.py
@@ -0,0 +1,131 @@
+import json
+import types
+from pathlib import Path
+
+import pytest
+import torch
+from hydra import compose, initialize_config_dir
+
+from fastwam import trainer
+from fastwam.datasets.lerobot.base_lerobot_dataset import build_image_delta_offsets
+from fastwam.datasets.lerobot.task_text import task_instruction
+from fastwam.trainer import build_optimizer, chunk_params
+from fastwam.utils.config_resolvers import register_default_resolvers
+
+CONFIG_DIR = str(Path(__file__).resolve().parent.parent / "configs")
+FRAMES = 1_259_153
+WORLD_SIZE = 2
+
+register_default_resolvers()
+
+
+def _compose(task: str, *overrides: str):
+    with initialize_config_dir(config_dir=CONFIG_DIR, version_base="1.3"):
+        return compose(config_name="train", overrides=[f"task={task}", *overrides])
+
+
+def test_one_epoch_at_effective_batch_128_over_two_ranks():
+    cfg = _compose("sweep_bench_uncond_2cam224_1e-4")
+    assert cfg.batch_size * cfg.gradient_accumulation_steps * WORLD_SIZE == 128
+    assert (cfg.max_steps - 1) * 128 < FRAMES <= cfg.max_steps * 128
+
+
+def test_recipe_is_cosine_lr_1e_4_with_8bit_adamw_and_gradient_checkpointing():
+    cfg = _compose("sweep_bench_uncond_2cam224_1e-4")
+    assert cfg.data.train.dataset_dirs == ["./data/sweep_bench_ee_dom"]
+    assert cfg.data.train.text_embedding_cache_dir == "./data/text_embeds_cache/sweep_bench"
+    assert cfg.num_epochs == 1
+    assert cfg.lr_scheduler_type == "cosine"
+    assert cfg.learning_rate == 1e-4
+    assert cfg.weight_decay == 1e-2
+    assert cfg.optimizer == "adamw8bit"
+    assert cfg.model.mot_checkpoint_mixed_attn is True
+
+
+def test_raw_task_is_the_env_instruction():
+    raw = json.dumps({"task": "raw", "instructions": ["seat the rod in the notched carrier on the conveyor belt"]})
+    assert task_instruction(raw) == "seat the rod in the notched carrier on the conveyor belt"
+
+
+@pytest.mark.parametrize(
+    "task",
+    ["put the bowl on the plate", json.dumps({"task": "place", "objects": ["orange"], "containers": ["red bowl"]})],
+)
+def test_other_tasks_are_unchanged(task):
+    assert task_instruction(task) == task
+
+
+def test_raw_task_with_several_instructions_is_refused():
+    with pytest.raises(ValueError):
+        task_instruction(json.dumps({"task": "raw", "instructions": ["a", "b"]}))
+
+
+def test_build_optimizer():
+    params = [torch.nn.Parameter(torch.zeros(4096))]
+    assert isinstance(build_optimizer("adamw", params, lr=1e-4, weight_decay=0.0, betas=(0.9, 0.95)), torch.optim.AdamW)
+    with pytest.raises(ValueError):
+        build_optimizer("sgd", params, lr=1e-4, weight_decay=0.0, betas=(0.9, 0.95))
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="bitsandbytes 8-bit kernels need CUDA")
+def test_adamw8bit_steps_on_gpu():
+    param = torch.nn.Parameter(torch.ones(8192, device="cuda"))
+    opt = build_optimizer("adamw8bit", [param], lr=1e-2, weight_decay=0.0, betas=(0.9, 0.95))
+    param.grad = torch.ones_like(param)
+    opt.step()
+    assert torch.all(param < 1)
+
+
+def test_chunk_params_keeps_every_group_under_the_limit():
+    params = [torch.nn.Parameter(torch.zeros(n)) for n in (6, 3, 3, 5, 1)]
+    groups = chunk_params(params, max_numel=8)
+    assert [[p.numel() for p in g] for g in groups] == [[6], [3, 3], [5, 1]]
+    assert [p for g in groups for p in g] == params
+    with pytest.raises(ValueError):
+        chunk_params([torch.nn.Parameter(torch.zeros(9))], max_numel=8)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="bitsandbytes 8-bit kernels need CUDA")
+def test_adamw8bit_splits_groups(monkeypatch):
+    monkeypatch.setattr(trainer, "MAX_8BIT_GROUP_NUMEL", 8192)
+    params = [torch.nn.Parameter(torch.ones(8192, device="cuda")) for _ in range(3)]
+    opt = build_optimizer("adamw8bit", params, lr=1e-2, weight_decay=0.0, betas=(0.9, 0.95))
+    assert len(opt.param_groups) == 3
+
+
+def test_retention_keeps_the_newest_state_and_sparse_weights(tmp_path):
+    cfg = _compose("sweep_bench_uncond_2cam224_1e-4")
+    state_dir, weights_dir = tmp_path / "state", tmp_path / "weights"
+    for step in (500, 1000, 1500, 2000, 2500):
+        (state_dir / f"step_{step:06d}").mkdir(parents=True)
+        weights_dir.mkdir(exist_ok=True)
+        (weights_dir / f"step_{step:06d}.pt").touch()
+    fake = types.SimpleNamespace(
+        keep_last_states=cfg.keep_last_states,
+        keep_weights_every=cfg.keep_weights_every,
+        state_dir=str(state_dir),
+        weights_dir=str(weights_dir),
+        global_step=2500,
+    )
+    trainer.Wan22Trainer._prune_checkpoints(fake)
+    assert sorted(p.name for p in state_dir.iterdir()) == ["step_002500"]
+    assert sorted(p.name for p in weights_dir.iterdir()) == ["step_002000.pt", "step_002500.pt"]
+
+
+def test_retention_defaults_keep_everything():
+    with initialize_config_dir(config_dir=CONFIG_DIR, version_base="1.3"):
+        base = compose(config_name="train")
+    assert base.keep_last_states is None and base.keep_weights_every is None
+
+
+def test_history_adds_t_minus_4_and_t_minus_2_and_nothing_else():
+    no_history = _compose("sweep_bench_uncond_2cam224_1e-4", "data.train.num_history_frames=0", "data.train.history_stride=2")
+    history = _compose("sweep_bench_uncond_2cam224_1e-4", "data.train.num_history_frames=2", "data.train.history_stride=2")
+    dt = history.data.train
+    offsets = build_image_delta_offsets(
+        dt.num_history_frames, dt.history_stride * dt.global_sample_stride, past_obs_size=0, obs_size=dt.num_frames
+    )
+    assert offsets[:2] == [-4, -2]
+    history.data.train.num_history_frames = 0
+    history.data.train.processor.num_history_frames = 0
+    assert history == no_history
