diff --git a/src/fastwam/utils/belt_speed.py b/src/fastwam/utils/belt_speed.py
new file mode 100644
index 0000000..2110edd
--- /dev/null
+++ b/src/fastwam/utils/belt_speed.py
@@ -0,0 +1,6 @@
+SPEED_CENTER = 0.25
+SPEED_SCALE = 0.15
+
+
+def encode_speed(speed: float) -> float:
+    return (speed - SPEED_CENTER) / SPEED_SCALE
diff --git a/tests/test_gt_speed.py b/tests/test_gt_speed.py
new file mode 100644
index 0000000..4cc5198
--- /dev/null
+++ b/tests/test_gt_speed.py
@@ -0,0 +1,136 @@
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+from omegaconf import OmegaConf
+
+from fastwam.datasets.lerobot import robot_video_dataset
+from fastwam.utils.belt_speed import encode_speed
+
+from test_history_conditioning import (
+    ACTION_HORIZON,
+    HEIGHT,
+    PROPRIO_DIM,
+    TEXT_DIM,
+    WIDTH,
+    build_model,
+    build_sample,
+)
+
+SPEEDS = (0.12, 0.37)
+
+
+def _with_speed(sample: dict) -> dict:
+    proprio = sample["proprio"]
+    speed = torch.tensor([encode_speed(v) for v in SPEEDS]).view(-1, 1, 1).expand(-1, proprio.shape[1], 1)
+    return {**sample, "proprio": torch.cat([proprio, speed], dim=-1)}
+
+
+def _loss(model, sample: dict) -> torch.Tensor:
+    torch.manual_seed(5)
+    loss, _ = model.training_loss(sample)
+    return loss
+
+
+def _action(model, proprio: torch.Tensor) -> torch.Tensor:
+    torch.manual_seed(4)
+    return model.infer_action(
+        prompt=None,
+        input_image=torch.rand(1, 3, HEIGHT, WIDTH) * 2 - 1,
+        action_horizon=ACTION_HORIZON,
+        context=torch.randn(1, 5, TEXT_DIM),
+        context_mask=torch.ones(1, 5, dtype=torch.bool),
+        proprio=proprio,
+        num_inference_steps=2,
+        seed=0,
+    )["action"]
+
+
+def test_the_speed_weight_starts_at_zero_and_every_other_weight_is_the_plain_models() -> None:
+    plain, conditioned = build_model(), build_model(speed_conditioned=True)
+    assert conditioned.proprio_dim == PROPRIO_DIM + 1
+    assert not conditioned.proprio_encoder.speed.weight.any()
+    renamed = {k.replace("proprio_encoder.state.", "proprio_encoder."): v for k, v in conditioned.state_dict().items()}
+    del renamed["proprio_encoder.speed.weight"]
+    plain_state = plain.state_dict()
+    assert plain_state.keys() == renamed.keys()
+    for key in plain_state:
+        assert torch.equal(plain_state[key], renamed[key]), key
+
+
+def test_the_first_loss_and_actions_are_the_plain_models() -> None:
+    plain, conditioned = build_model(), build_model(speed_conditioned=True)
+    sample = build_sample(num_history=2)
+    assert torch.equal(_loss(conditioned, _with_speed(sample)), _loss(plain, sample))
+    proprio = torch.randn(1, PROPRIO_DIM)
+    for speed in (0.10, 0.40):
+        with_speed = torch.cat([proprio, torch.tensor([[encode_speed(speed)]])], dim=-1)
+        assert torch.equal(_action(conditioned, with_speed), _action(plain, proprio))
+
+
+def test_the_speed_weight_gets_a_gradient() -> None:
+    conditioned = build_model(speed_conditioned=True)
+    _loss(conditioned, _with_speed(build_sample(num_history=2))).backward()
+    grad = conditioned.proprio_encoder.speed.weight.grad
+    assert grad is not None
+    assert grad.abs().sum() > 0
+
+
+def test_a_proprio_of_the_other_width_is_refused() -> None:
+    sample = build_sample(num_history=2)
+    with pytest.raises(ValueError, match="last dim"):
+        build_model(speed_conditioned=True).training_loss(sample)
+    with pytest.raises(ValueError, match="last dim"):
+        build_model().training_loss(_with_speed(sample))
+
+
+def test_the_encoding_maps_the_trained_range_to_plus_minus_one() -> None:
+    assert encode_speed(0.10) == pytest.approx(-1.0)
+    assert encode_speed(0.25) == pytest.approx(0.0)
+    assert encode_speed(0.40) == pytest.approx(1.0)
+
+
+class _StubLerobotDataset:
+    def __init__(self, total: int = 4, episodes=None, lengths=(3, 2, 4, 1)) -> None:
+        ends = torch.tensor(lengths).cumsum(0)
+        self.episode_data_index = {"from": ends - torch.tensor(lengths), "to": ends}
+        inner = SimpleNamespace(meta=SimpleNamespace(total_episodes=total), episodes=episodes)
+        self.multi_dataset = SimpleNamespace(_datasets=[inner])
+
+    def _set_return_images(self, flag: bool) -> None:
+        pass
+
+
+SHAPE_META = OmegaConf.create({"images": [{"key": "opst_cam"}, {"key": "wrist_cam"}]})
+
+
+def _dataset(monkeypatch, tmp_path: Path, speeds, dataset_dirs=("d",), **stub):
+    monkeypatch.setattr(robot_video_dataset, "BaseLerobotDataset", lambda **_k: _StubLerobotDataset(**stub))
+    path = tmp_path / "speeds.json"
+    path.write_text(json.dumps(speeds))
+    return robot_video_dataset.RobotVideoDataset(
+        dataset_dirs=list(dataset_dirs), shape_meta=SHAPE_META, video_size=[224, 448], speed_list=str(path)
+    )
+
+
+def test_each_frame_maps_to_its_own_episode(monkeypatch, tmp_path: Path) -> None:
+    dataset = _dataset(monkeypatch, tmp_path, [0.1, 0.2, 0.3, 0.4])
+    assert [dataset._episode_of(i) for i in range(10)] == [0, 0, 0, 1, 1, 2, 2, 2, 2, 3]
+
+
+def test_an_episode_subset_maps_to_the_global_episode(monkeypatch, tmp_path: Path) -> None:
+    dataset = _dataset(monkeypatch, tmp_path, [0.1, 0.2, 0.3, 0.4], episodes=[3, 0, 2], lengths=(1, 3, 4))
+    assert [dataset._episode_of(i) for i in range(8)] == [3, 0, 0, 0, 2, 2, 2, 2]
+
+
+@pytest.mark.parametrize("speeds", [[0.1, 0.2, 0.3], [0.1, 0.2, 0.3, -0.4], [0.1, 0.2, 0.3, "fast"]])
+def test_a_list_that_does_not_cover_the_dataset_is_refused(monkeypatch, tmp_path: Path, speeds) -> None:
+    with pytest.raises(ValueError, match="positive speeds"):
+        _dataset(monkeypatch, tmp_path, speeds)
+
+
+def test_a_list_for_several_datasets_is_refused(monkeypatch, tmp_path: Path) -> None:
+    with pytest.raises(ValueError, match="one dataset"):
+        _dataset(monkeypatch, tmp_path, [0.1, 0.2, 0.3, 0.4], dataset_dirs=("a", "b"))
