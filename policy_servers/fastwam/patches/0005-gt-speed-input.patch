 logger = get_logger(__name__)
 
 
+class SpeedProprioEncoder(nn.Module):
+    def __init__(self, state: nn.Linear):
+        super().__init__()
+        self.state = state
+        self.speed = nn.utils.skip_init(nn.Linear, 1, state.out_features, bias=False, dtype=state.weight.dtype)
+        nn.init.zeros_(self.speed.weight)
+
+    def forward(self, proprio: torch.Tensor) -> torch.Tensor:
+        return self.state(proprio[..., :-1].contiguous()) + self.speed(proprio[..., -1:])
+
+
