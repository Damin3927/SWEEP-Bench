+def test_pre_dit_cond_prefix_gets_zero_timestep():
+    model = build_model()
+    num_cond = 3
+    latents = torch.randn(BATCH, Z_DIM, 5, 2, 4)
+    context = torch.randn(BATCH, 5, TEXT_DIM)
+    timestep = torch.full((BATCH,), 700.0)
+    pre = model.video_expert.pre_dit(
+        x=latents, timestep=timestep, context=context,
+        fuse_vae_embedding_in_latents=True, num_cond_latents=num_cond,
+    )
+    pre_zero = model.video_expert.pre_dit(
+        x=latents, timestep=torch.zeros(BATCH), context=context,
+        fuse_vae_embedding_in_latents=True, num_cond_latents=num_cond,
+    )
+    tokens_per_frame = pre["meta"]["tokens_per_frame"]
+    cond_tokens = num_cond * tokens_per_frame
+    assert torch.allclose(pre["t_mod"][:, :cond_tokens], pre_zero["t_mod"][:, :cond_tokens])
+    assert not torch.allclose(pre["t_mod"][:, cond_tokens:], pre_zero["t_mod"][:, cond_tokens:])
