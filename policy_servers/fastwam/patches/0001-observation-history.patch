@@ -0,0 +1,496 @@
+import types
+
+import pytest
+import torch
+
+from fastwam.models.wan22.action_dit import ActionDiT
+from fastwam.models.wan22.fastwam import FastWAM
+from fastwam.models.wan22.fastwam_idm import FastWAMIDM
+from fastwam.models.wan22.fastwam_joint import FastWAMJoint
+from fastwam.models.wan22.mot import MoT
+from fastwam.models.wan22.wan_video_dit import WanVideoDiT
+
+Z_DIM = 4
+TEXT_DIM = 32
+ACTION_DIM = 7
+PROPRIO_DIM = 6
+HEIGHT, WIDTH = 32, 64
+NUM_FRAMES = 9
+ACTION_HORIZON = 8
+BATCH = 2
+
+
+class FakeVAE(torch.nn.Module):
+    def __init__(self, z_dim=Z_DIM, temporal_downsample_factor=4, upsampling_factor=16):
+        super().__init__()
+        self.z_dim = z_dim
+        self.temporal_downsample_factor = temporal_downsample_factor
+        self.upsampling_factor = upsampling_factor
+        self.model = types.SimpleNamespace(z_dim=z_dim)
+
+    def encode(self, videos, device, tiled=False, tile_size=(30, 52), tile_stride=(15, 26)):
+        outs = []
+        for video in videos:
+            _, t, h, w = video.shape
+            assert (t - 1) % self.temporal_downsample_factor == 0
+            latent_t = (t - 1) // self.temporal_downsample_factor + 1
+            lh, lw = h // self.upsampling_factor, w // self.upsampling_factor
+            v = video.float()
+            groups = [v[:, 0:1]]
+            for i in range(latent_t - 1):
+                start = 1 + i * self.temporal_downsample_factor
+                groups.append(v[:, start:start + self.temporal_downsample_factor])
+            feats = []
+            for g in groups:
+                gm = torch.nn.functional.adaptive_avg_pool2d(g.mean(dim=1), (lh, lw))
+                feats.append(gm.mean(dim=0, keepdim=True).repeat(self.z_dim, 1, 1))
+            outs.append(torch.stack(feats, dim=1))
+        return torch.stack(outs).to(device)
+
+    def decode(self, hidden_states, device, tiled=False, tile_size=(30, 52), tile_stride=(15, 26)):
+        vids = []
+        for hs in hidden_states:
+            _, t, lh, lw = hs.shape
+            frames_t = (t - 1) * self.temporal_downsample_factor + 1
+            vids.append(torch.zeros(3, frames_t, lh * self.upsampling_factor, lw * self.upsampling_factor))
+        return torch.stack(vids).to(device)
+
+
+def build_model(cls=FastWAM, action_conditioned=False):
+    torch.manual_seed(0)
+    video_expert = WanVideoDiT(
+        hidden_dim=48,
+        in_dim=Z_DIM,
+        ffn_dim=96,
+        out_dim=Z_DIM,
+        text_dim=TEXT_DIM,
+        freq_dim=32,
+        eps=1e-6,
+        patch_size=(1, 2, 2),
+        num_heads=2,
+        attn_head_dim=24,
+        num_layers=2,
+        has_image_input=False,
+        seperated_timestep=True,
+        require_vae_embedding=False,
+        require_clip_embedding=False,
+        fuse_vae_embedding_in_latents=True,
+        action_conditioned=action_conditioned,
+        action_dim=ACTION_DIM,
+        action_group_causal_mask_mode="group_diagonal",
+        video_attention_mask_mode="first_frame_causal",
+        use_gradient_checkpointing=False,
+    )
+    action_expert = ActionDiT(
+        hidden_dim=48,
+        action_dim=ACTION_DIM,
+        ffn_dim=96,
+        text_dim=TEXT_DIM,
+        freq_dim=32,
+        eps=1e-6,
+        num_heads=2,
+        attn_head_dim=24,
+        num_layers=2,
+    )
+    mot = MoT(
+        mixtures={"video": video_expert, "action": action_expert},
+        mot_checkpoint_mixed_attn=False,
+    )
+    return cls(
+        video_expert=video_expert,
+        action_expert=action_expert,
+        mot=mot,
+        vae=FakeVAE(),
+        text_encoder=None,
+        tokenizer=None,
+        text_dim=TEXT_DIM,
+        proprio_dim=PROPRIO_DIM,
+        device="cpu",
+        torch_dtype=torch.float32,
+    )
+
