+def test_mask_padded_cond_tokens():
+    model = build_model()
+    tokens_per_frame = 2
+    video_seq_len = 5 * tokens_per_frame
+    base = model._build_mot_attention_mask(
+        video_seq_len=video_seq_len,
+        action_seq_len=ACTION_HORIZON,
+        video_tokens_per_frame=tokens_per_frame,
+        device=torch.device("cpu"),
+        num_cond_frames=3,
+    )
+    cond_is_pad = torch.tensor([[True, False, False], [False, False, False]])
+    masked = model._mask_padded_cond_tokens(base, cond_is_pad, tokens_per_frame)
+    assert tuple(masked.shape) == (2, 1, base.shape[0], base.shape[1])
+    assert masked[0, 0, :, :tokens_per_frame].sum() == 0
+    assert torch.equal(masked[0, 0, :, tokens_per_frame:], base[:, tokens_per_frame:])
+    assert torch.equal(masked[1, 0], base)
+    assert masked.any(dim=-1).all()
+    assert model._mask_padded_cond_tokens(base, torch.zeros(2, 3, dtype=torch.bool), tokens_per_frame).ndim == 2
