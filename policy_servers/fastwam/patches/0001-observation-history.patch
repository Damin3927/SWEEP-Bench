+def _run_mot_video_action(model, latents, num_cond, cond_is_pad):
+    torch.manual_seed(7)
+    batch_size = latents.shape[0]
+    context = torch.randn(batch_size, 5, TEXT_DIM)
+    context_mask = torch.ones(batch_size, 5, dtype=torch.bool)
+    action = torch.randn(batch_size, ACTION_HORIZON, ACTION_DIM)
+    video_pre = model.video_expert.pre_dit(
+        x=latents, timestep=torch.full((batch_size,), 500.0), context=context,
+        context_mask=context_mask, fuse_vae_embedding_in_latents=True, num_cond_latents=num_cond,
+    )
+    action_pre = model.action_expert.pre_dit(
+        action_tokens=action, timestep=torch.full((batch_size,), 300.0),
+        context=context, context_mask=context_mask,
+    )
+    tokens_per_frame = int(video_pre["meta"]["tokens_per_frame"])
+    mask = model._build_mot_attention_mask(
+        video_seq_len=video_pre["tokens"].shape[1],
+        action_seq_len=action_pre["tokens"].shape[1],
+        video_tokens_per_frame=tokens_per_frame,
+        device=torch.device("cpu"),
+        num_cond_frames=num_cond,
+    )
+    mask = model._mask_padded_cond_tokens(mask, cond_is_pad, tokens_per_frame)
+    out = model.mot(
+        embeds_all={"video": video_pre["tokens"], "action": action_pre["tokens"]},
+        attention_mask=mask,
+        freqs_all={"video": video_pre["freqs"], "action": action_pre["freqs"]},
+        context_all={
+            "video": {"context": video_pre["context"], "mask": video_pre["context_mask"]},
+            "action": {"context": action_pre["context"], "mask": action_pre["context_mask"]},
+        },
+        t_mod_all={"video": video_pre["t_mod"], "action": action_pre["t_mod"]},
+    )
+    return out, tokens_per_frame
+
+
+def test_padded_slot_content_has_no_effect():
+    model = build_model()
+    model.eval()
+    torch.manual_seed(8)
+    lh, lw = 2, 4
+    real_hist = torch.randn(1, Z_DIM, 1, lh, lw)
+    current = torch.randn(1, Z_DIM, 1, lh, lw)
+    future = torch.randn(1, Z_DIM, 2, lh, lw)
+    garbage_a = torch.randn(1, Z_DIM, 1, lh, lw)
+    garbage_b = torch.randn(1, Z_DIM, 1, lh, lw)
+    cond_is_pad = torch.tensor([[True, False, False]])
+
+    latents_a = torch.cat([garbage_a, real_hist, current, future], dim=2)
+    latents_b = torch.cat([garbage_b, real_hist, current, future], dim=2)
+
+    out_a, tpf = _run_mot_video_action(model, latents_a, num_cond=3, cond_is_pad=cond_is_pad)
+    out_b, _ = _run_mot_video_action(model, latents_b, num_cond=3, cond_is_pad=cond_is_pad)
+
+    assert torch.allclose(out_a["video"][:, tpf:], out_b["video"][:, tpf:], atol=1e-6)
+    assert torch.allclose(out_a["action"], out_b["action"], atol=1e-6)
+
+    out_a_nomask, _ = _run_mot_video_action(model, latents_a, num_cond=3, cond_is_pad=None)
+    out_b_nomask, _ = _run_mot_video_action(model, latents_b, num_cond=3, cond_is_pad=None)
+    assert not torch.allclose(out_a_nomask["action"], out_b_nomask["action"], atol=1e-6)
+
