+@pytest.mark.parametrize("cls", [FastWAM, FastWAMJoint, FastWAMIDM])
+@pytest.mark.parametrize("num_history", [0, 2])
+def test_training_loss_runs(cls, num_history):
+    model = build_model(cls=cls)
+    model.train()
+    torch.manual_seed(2)
+    loss, loss_dict = model.training_loss(build_sample(num_history))
+    assert torch.isfinite(loss)
