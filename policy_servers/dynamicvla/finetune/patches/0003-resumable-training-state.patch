+def _bench_train_state():
+    import importlib.util
+    import sys
+
+    module = sys.modules.get("bench_train_state")
+    if module is None:
+        path = os.path.join(
+            os.path.dirname(os.path.abspath(__file__)),
+            os.pardir,
+            os.pardir,
+            "finetune",
+            "train_state.py",
+        )
+        spec = importlib.util.spec_from_file_location("bench_train_state", path)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules["bench_train_state"] = module
+        spec.loader.exec_module(module)
+    return module
+
